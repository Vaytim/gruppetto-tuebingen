# Diese Werte in Netlify unter Site configuration → Environment variables eintragen.
# Für lokale Tests mit `netlify dev` in eine Datei .env kopieren (nie committen!).

# Stripe: Dashboard → Entwickler → API-Schlüssel (zum Testen sk_test_…)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe: Dashboard → Entwickler → Webhooks → Endpunkt → Signaturgeheimnis
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Mailversand über Brevo (SMTP) – Login und Schlüssel aus Brevo → SMTP & API
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=xxxx@smtp-brevo.com
SMTP_PASS=geheim
# Absender für Anmeldebestätigungen (und später Shop-Käufe)
MAIL_FROM="Gruppetto Tübingen <shop@gruppetto-tuebingen.de>"
# Kontaktformular: Absender und Empfänger
KONTAKT_FROM="Gruppetto Tübingen Kontaktformular <kontakt@gruppetto-tuebingen.de>"
KONTAKT_EMPFAENGER=gruppettotuebingen@gmail.com
# optional: Antworten gehen hierhin / Kopie jeder Bestätigung an euch
MAIL_REPLY_TO=info@gruppetto-tuebingen.de
MAIL_BCC=

# Passwort für /api/teilnehmer (Teilnehmerliste)
ADMIN_PASSWORD=ein-langes-zufaelliges-passwort

# optional, sonst nimmt Netlify automatisch die Site-URL
SITE_URL=https://gruppetto-tuebingen.de
