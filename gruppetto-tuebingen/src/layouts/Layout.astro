---
// Grundlayout: schmale Info-Leiste oben, Menü-Button links (bleibt beim Scrollen),
// Wortmarke rechts oben, Vollbild-Menü, Footer mit Linkspalten + großer Wortmarke.
//
// fullBleed = true  → Seite bestimmt ihre Breiten selbst (z. B. Startseite mit Vollbild-Hero)
// fullBleed = false → Inhalt läuft in einem Container mit Seitenrand (alle anderen Seiten)
interface Props {
  title: string;
  description?: string;
  fullBleed?: boolean;
}

const { title, description = "Gruppetto Tübingen – lokale Rennrad-Community", fullBleed = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

// Info-Leiste ganz oben – Text und Ziel hier anpassen
const infoBar = { text: "Season Closed! We’ll be back 2027.", href: "/rides" };

const mainNav = [
  { label: "Weekly Rides", href: "/rides" },
  { label: "Events", href: "/events" },
  { label: "Über uns", href: "/ueber-uns" },
  { label: "Shop", href: "/shop" },
];

// Bildkacheln im geöffneten Menü (rechts)
const menuTeasers = [
  { label: "Unsere Routen", href: "/rides#unsere-routen", image: "/images/truppe-banner-2.png" },
  { label: "Season 2026 Kit", href: "/shop", image: "https://picsum.photos/seed/gruppetto-kit-1/600/600" },
];

const menuSmallLinks = [
  { label: "Alle Links", href: "/links" },
  { label: "Instagram", href: "https://www.instagram.com/gruppetto.tuebingen/", external: true },
  { label: "Strava", href: "https://www.strava.com/clubs/gruppetto-tuebingen", external: true },
];

const footerColumns = [
  [
    { label: "Weekly Rides", href: "/rides" },
    { label: "Events", href: "/events" },
    { label: "Unsere Routen", href: "/rides#unsere-routen" },
  ],
  [
    { label: "Über uns", href: "/ueber-uns" },
    { label: "Shop", href: "/shop" },
    { label: "Alle Links", href: "/links" },
  ],
  [
    { label: "Instagram", href: "https://www.instagram.com/gruppetto.tuebingen/", external: true },
    { label: "Strava Club", href: "https://www.strava.com/clubs/gruppetto-tuebingen", external: true },
  ],
  [{ label: "Rechtliches", href: "/rechtliches" }],
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} · Gruppetto Tübingen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;500;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={[{ "is-full-bleed": fullBleed, "is-subpage": Astro.url.pathname !== "/" }]}>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    <!-- Info-Leiste -->
    <a class="info-bar" href={infoBar.href}>
      <span class="info-bar-text">{infoBar.text}</span>
      <span aria-hidden="true">→</span>
    </a>

    <!-- Kopf: Menü-Button links (fixiert), Wortmarke rechts -->
    <header class="site-header">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Menü öffnen">
        <span></span><span></span>
      </button>
      <a href="/" class="wordmark" aria-label="Gruppetto Tübingen – Startseite">
        <span>gruppetto</span><span>tübingen</span>
      </a>
    </header>

    <!-- Vollbild-Menü -->
    <div class="site-menu" id="site-menu" hidden>
      <div class="site-menu-inner">
        <nav class="menu-main" aria-label="Hauptnavigation">
          {mainNav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="menu-teasers">
          {menuTeasers.map((t) => (
            <a href={t.href} class="menu-teaser">
              <img src={t.image} alt="" loading="lazy" />
              <span>{t.label}</span>
            </a>
          ))}
        </div>
        <nav class="menu-small" aria-label="Weitere Links">
          {menuSmallLinks.map((l) => (
            <a href={l.href} target={l.external ? "_blank" : undefined} rel={l.external ? "noopener" : undefined}>{l.label}{l.external && " ↗"}</a>
          ))}
        </nav>
      </div>
    </div>

    <main id="inhalt" class={fullBleed ? "main-full" : "main-contained"}>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-top">
        <a class="btn btn-accent" href="https://www.instagram.com/gruppetto.tuebingen/" target="_blank" rel="noopener">Folge uns auf Instagram</a>
        <div class="footer-social">
          <a href="https://www.instagram.com/gruppetto.tuebingen/" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"/></svg>
          </a>
          <a href="https://www.strava.com/clubs/gruppetto-tuebingen" target="_blank" rel="noopener" aria-label="Strava">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 2 4 14h4l2-4 2 4h4L10 2Zm6 12-2 4-2-4h-2.5L14 22l4.5-8H16Z" fill="currentColor"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-columns">
        {footerColumns.map((col) => (
          <ul>
            {col.map((l) => (
              <li><a href={l.href} target={l.external ? "_blank" : undefined} rel={l.external ? "noopener" : undefined}>{l.label}{l.external && " ↗"}</a></li>
            ))}
          </ul>
        ))}
      </div>

      <p class="footer-claim">Keep it simple. Ride together.</p>
      <p class="footer-wordmark" aria-hidden="true">gruppetto</p>
    </footer>

    <script>
      import "lenis/dist/lenis.css";
      import { initSmoothScroll } from "../lib/motion";
      initSmoothScroll(); // weiches Scrollen auf allen Seiten
    </script>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle")!;
      const menu = document.getElementById("site-menu")!;
      const setOpen = (open: boolean) => {
        menu.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
        document.body.classList.toggle("menu-open", open);
        if (open) menu.querySelector<HTMLAnchorElement>("a")?.focus();
      };
      toggle.addEventListener("click", () => setOpen(menu.hidden));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !menu.hidden) {
          setOpen(false);
          toggle.focus();
        }
      });
      // Menü-Button bekommt Hintergrund, sobald gescrollt wird
      const onScroll = () => document.body.classList.toggle("scrolled", window.scrollY > 40);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>

    <style is:global>
      :root {
        /* Farbpalette */
        --navy-900: #0d1e40; /* dunkelster Ton – Seitenhintergrund */
        --navy-800: #021859; /* Navy – Flächen, Footer, Menü */
        --navy-700: #04328c; /* Mittelblau – Karten, Linien */
        --blue-500: #0f4abf; /* Akzentblau – Buttons, Bänder */
        --light-100: #f2f2f2; /* Hell – Text auf Blau, helle Abschnitte */

        --color-bg: var(--navy-900);
        --color-bg-alt: var(--navy-800);
        --color-bg-soft: var(--navy-800);
        --color-bg-raised: var(--navy-700);
        --color-line: var(--navy-700);
        --color-text: var(--light-100);
        --color-text-muted: rgba(242, 242, 242, 0.72);
        --color-accent: var(--blue-500); /* nur als Fläche – als Text auf Dunkelblau zu kontrastarm */
        --color-on-accent: var(--light-100);
        --color-highlight: var(--light-100); /* hervorgehobener Text auf dunklem Grund */
        --font-title: "League Spartan", sans-serif;
        --font-body: "Inter", sans-serif;
        --gutter: clamp(16px, 1.4vw, 24px); /* Seitenrand – überall gleich */
        --info-bar-h: 42px;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--color-bg); color: var(--color-text); font-family: var(--font-body); }
      body { overflow-x: hidden; }
      body.menu-open { overflow: hidden; }
      img { max-width: 100%; }

      h1, h2, h3 { font-family: var(--font-title); font-weight: 500; letter-spacing: -0.01em; line-height: 1.05; }
      a { color: inherit; }

      .skip-link { position: absolute; left: -9999px; top: 0; z-index: 100; background: var(--color-accent); color: var(--color-on-accent); padding: 0.6rem 1rem; }
      .skip-link:focus { left: var(--gutter); }

      /* ---------- Info-Leiste ---------- */
      .info-bar {
        display: flex; align-items: center; justify-content: center; gap: 0.75rem;
        height: var(--info-bar-h); padding: 0 var(--gutter);
        background: var(--navy-800); color: var(--color-text); font-size: 0.9rem; text-decoration: none;
      }
      .info-bar-text { text-decoration: underline; text-underline-offset: 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
      .info-bar:hover .info-bar-text { text-decoration-thickness: 2px; }

      /* ---------- Kopf ---------- */
      .site-header {
        position: absolute; top: var(--info-bar-h); left: 0; right: 0; z-index: 30;
        display: flex; justify-content: space-between; align-items: flex-start;
        padding: calc(var(--gutter) * 1.6) var(--gutter); pointer-events: none;
      }
      .site-header > * { pointer-events: auto; }
      .menu-toggle {
        position: fixed; top: calc(var(--info-bar-h) + var(--gutter) * 1.2); left: var(--gutter); z-index: 60;
        display: grid; gap: 9px; align-content: center; width: 52px; height: 44px; padding: 0 2px;
        background: transparent; border: 0; cursor: pointer;
        transition: top 0.2s ease;
      }
      body.scrolled .menu-toggle { top: var(--gutter); }
      /* Farbe wie die klickbaren Kacheln: Navy, beim Drüberfahren Akzentblau */
      .menu-toggle span { display: block; height: 3px; background: var(--navy-800); transition: transform 0.25s ease, background 0.2s ease; }
      .menu-toggle:hover span { background: var(--blue-500); }
      /* Geöffnetes Menü (Navy-Hintergrund): X hell, damit es sichtbar bleibt */
      .menu-toggle[aria-expanded="true"] span { background: var(--light-100); }
      /* Unterseiten: Menü-Button immer im Weiß der Palette (auch beim Hovern) – auf dem dunklen Grund sonst kaum sichtbar */
      body.is-subpage .menu-toggle span,
      body.is-subpage .menu-toggle:hover span { background: var(--light-100); }
      .menu-toggle[aria-expanded="true"]:hover span { background: var(--blue-500); }
      .menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(6px) rotate(45deg); }
      .menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-6px) rotate(-45deg); }
      .menu-toggle:focus-visible { outline: 2px solid var(--color-highlight); outline-offset: 4px; }

      .wordmark {
        margin-left: auto; display: grid; justify-items: end; text-decoration: none;
        font-family: var(--font-title); font-weight: 500; font-size: clamp(1.5rem, 2.6vw, 2.6rem); line-height: 0.9; letter-spacing: -0.02em;
      }
      body.menu-open .site-header { position: fixed; z-index: 55; }

      /* ---------- Vollbild-Menü ---------- */
      .site-menu { position: fixed; inset: 0; z-index: 50; background: var(--navy-800); overflow-y: auto; }
      .site-menu-inner {
        min-height: 100%; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr auto;
        gap: 2rem var(--gutter); padding: calc(var(--info-bar-h) + 9rem) var(--gutter) var(--gutter);
      }
      .menu-main { display: grid; align-content: start; gap: 0.6rem; padding-left: 8vw; }
      .menu-main a {
        width: fit-content; font-family: var(--font-title); font-size: clamp(2.2rem, 4.2vw, 4rem); line-height: 1.1;
        text-decoration: none; border-bottom: 2px solid currentColor;
      }
      .menu-main a { transition: border-color 0.2s ease; }
      .menu-main a:hover, .menu-main a[aria-current="page"] { border-bottom-color: var(--blue-500); border-bottom-width: 4px; }
      .menu-teasers { display: flex; gap: var(--gutter); align-self: center; }
      .menu-teaser { width: min(220px, 40%); text-decoration: none; font-size: 0.95rem; }
      .menu-teaser img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; margin-bottom: 0.5rem; }
      .menu-teaser span { text-decoration: underline; text-underline-offset: 4px; }
      .menu-teaser:hover span { text-decoration-thickness: 2px; }
      .menu-small { grid-column: 1 / -1; display: grid; gap: 0.4rem; font-size: 0.95rem; }
      .menu-small a { width: fit-content; text-underline-offset: 4px; }
      .menu-small a:hover { text-decoration-thickness: 2px; }

      /* ---------- Hauptbereich ---------- */
      .main-contained { padding: calc(var(--gutter) * 2 + 8rem) var(--gutter) 4rem; max-width: 1280px; margin: 0 auto; }

      /* ---------- Buttons (eckig, wie im Layout-Vorbild) ---------- */
      .btn {
        display: inline-block; padding: 1rem 2.2rem; border: 0; border-radius: 0;
        background: var(--navy-800); color: var(--color-text); font: 500 0.95rem var(--font-body); letter-spacing: 0.02em;
        text-decoration: none; cursor: pointer; transition: background 0.2s ease, color 0.2s ease;
      }
      .btn:hover { background: var(--color-accent); color: var(--color-on-accent); }
      .btn-accent { background: var(--color-accent); color: var(--color-on-accent); }
      .btn-accent:hover { background: var(--navy-700); }

      .card { background: var(--color-bg-alt); padding: 1.5rem; margin-bottom: 1rem; }

      /* Pfeil-Überschrift ("Titel  ⟶") */
      .arrow-title { display: inline-flex; align-items: center; gap: 1.2rem; text-decoration: none; }
      .arrow-title::after { content: "⟶"; font-family: var(--font-body); font-weight: 300; transition: transform 0.2s ease; }
      a:hover .arrow-title::after, .arrow-title:hover::after { transform: translateX(6px); }

      /* ---------- Footer ---------- */
      .site-footer { background: var(--color-bg-soft); padding: 6rem var(--gutter) 0; overflow: hidden; }
      .footer-top { display: grid; justify-items: start; gap: 2rem; margin-left: 50%; padding-left: var(--gutter); margin-bottom: 5rem; }
      .footer-social { display: flex; gap: 1.6rem; }
      .footer-social a { color: var(--color-text); }
      .footer-social a:hover { color: var(--color-text-muted); }
      .footer-social svg { width: 26px; height: 26px; display: block; }
      .footer-columns { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem var(--gutter); }
      .footer-columns ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; align-content: start; }
      .footer-columns a { font-size: 1.05rem; text-decoration: underline; text-underline-offset: 5px; }
      .footer-columns a:hover { text-decoration-thickness: 2px; }
      .footer-wordmark {
        margin: 1rem 0 0; font-family: var(--font-title); font-weight: 500; color: var(--color-accent);
        font-size: 23vw; line-height: 0.82; letter-spacing: -0.05em; white-space: nowrap; transform: translateX(-0.03em);
      }
      .footer-claim { margin: 5rem 0 0; text-align: right; color: var(--color-text-muted); font-size: 0.85rem; }

      /* ---------- Mobil ---------- */
      @media (max-width: 760px) {
        .site-menu-inner { grid-template-columns: 1fr; padding-top: calc(var(--info-bar-h) + 7rem); }
        .menu-main { padding-left: 0; }
        .menu-teaser { width: 50%; }
        .main-contained { padding-top: calc(var(--gutter) + 7rem); }
        .footer-top { margin-left: 0; padding-left: 0; }
        .footer-columns { grid-template-columns: 1fr 1fr; }
        .info-bar { font-size: 0.8rem; }
      }
    </style>
  </body>
</html>
