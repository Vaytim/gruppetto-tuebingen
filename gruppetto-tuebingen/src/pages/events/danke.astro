---
import Layout from "../../layouts/Layout.astro";
import { events } from "../../data/events";

// Titel für die Anzeige im Browser (Event-ID kommt aus der URL)
const titles = Object.fromEntries(events.map((e) => [e.id, `${e.title} · ${e.dateLabel}`]));
---

<Layout title="Anmeldung bestätigt">
  <section class="thanks">
    <p class="kicker" id="event-title"></p>
    <h1 id="headline">Zahlung wird bestätigt …</h1>

    <div class="number-card" id="number-card" hidden>
      <p>Deine Startnummer</p>
      <strong id="start-number"></strong>
    </div>

    <p id="message">Das dauert meist nur ein paar Sekunden.</p>
    <a class="test-mail" id="test-mail" href="#" hidden>🧪 Testmodus: Bestätigungsmail ansehen →</a>
    <a class="back" href="/events">← Zurück zu den Events</a>
  </section>
</Layout>

<script define:vars={{ titles }}>
  const params = new URLSearchParams(location.search);
  const eventId = params.get("event") ?? "";
  const ref = params.get("ref") ?? "";
  const headline = document.getElementById("headline");
  const message = document.getElementById("message");
  document.getElementById("event-title").textContent = titles[eventId] ?? "";

  let tries = 0;
  async function poll() {
    tries++;
    try {
      const res = await fetch(`/api/event-status?event=${encodeURIComponent(eventId)}&ref=${encodeURIComponent(ref)}`, {
        cache: "no-store",
      });
      const data = await res.json();
      if (data.status === "paid") {
        headline.textContent = "Du bist dabei!";
        document.getElementById("start-number").textContent = data.startNumber;
        document.getElementById("number-card").hidden = false;
        message.textContent = "Wir haben dir eine Bestätigung mit Startnummer und Zahlungseingang per E-Mail geschickt. Schau auch im Spam-Ordner nach.";
        if (data.testMailUrl) {
          const link = document.getElementById("test-mail");
          link.href = data.testMailUrl;
          link.hidden = false;
        }
        return;
      }
    } catch {
      /* einfach erneut versuchen */
    }
    if (tries < 20) {
      setTimeout(poll, 1500);
    } else {
      headline.textContent = "Danke für deine Zahlung!";
      message.textContent = "Die Bestätigung dauert etwas länger als üblich. Deine Startnummer kommt per E-Mail – falls nicht innerhalb einer Stunde, melde dich bei uns mit deiner Referenz " + ref + ".";
    }
  }
  poll();
</script>

<style>
  .thanks { padding: 5rem 0; max-width: 34rem; }
  .kicker { margin: 0 0 0.5rem; color: var(--color-highlight); font-weight: 600; min-height: 1.2em; }
  h1 { margin: 0 0 1.5rem; font-family: var(--font-title); }
  .number-card {
    display: inline-block; min-width: 14rem; margin-bottom: 1.5rem; padding: 1.5rem 2rem; border-radius: 20px;
    background: var(--color-bg-alt); text-align: center;
  }
  .number-card p { margin: 0; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); }
  .number-card strong { display: block; font-family: var(--font-title); font-size: 4.5rem; line-height: 1.1; color: var(--color-highlight); }
  #message { color: var(--color-text-muted); line-height: 1.5; }
  .test-mail { display: block; margin-top: 1rem; padding: 0.75rem 1rem; border-radius: 12px; background: #ffb020; color: #3d2600; font-weight: 600; text-decoration: none; width: fit-content; }
  .test-mail[hidden] { display: none; }
  .back { display: inline-block; margin-top: 1.5rem; color: var(--color-highlight); }
</style>
