---
// FAQ – Fragen und Antworten unten in `groups` anpassen.
// html: erlaubt Links im Text. Leeres html = Frage erscheint mit „Antwort folgt“.
import Layout from "../layouts/Layout.astro";

const STRAVA = "https://www.strava.com/clubs/gruppetto-tuebingen";
const INSTAGRAM = "https://www.instagram.com/gruppetto.tuebingen/";

const groups = [
  {
    title: "Mitfahren",
    items: [
      {
        q: "Wo und wann trefft ihr euch?",
        html: `Mittwochs um 18:15 Uhr am Finanzamt Tübingen zum Road Ride, donnerstags um 18:30 Uhr am Technischen Rathaus zum Gravel-Treff. Alle Details und Routen findest du unter <a href="/rides">Weekly Rides</a>.`,
      },
      {
        q: "Wie fit muss ich sein, um mitzufahren?",
        html: `Wir fahren in mehreren Tempo-Gruppen. Die entspannteste ist unser After Work Ride mit einem Schnitt von rund 24 km/h – gemessen über die ganze Runde, Anstiege inklusive. Ist dir das noch zu schnell, starte mit einem <a href="/rookies">Rookie Ride</a>: Dort gibt die Gruppe das Tempo vor, nicht die Uhr.`,
      },
      {
        q: "Kostet das Mitfahren etwas?",
        html: `Nein. Unsere Weekly Rides sind und bleiben kostenlos. Nur bei manchen Events gibt es eine Teilnahmegebühr – die steht dann direkt beim Event.`,
      },
      {
        q: "Muss ich mich vorher anmelden?",
        html: `Für die Weekly Rides reicht ein kurzes „Ja“ auf Strava, damit wir wissen, mit wie vielen Leuten wir rechnen können. Tritt dafür am besten unserem <a href="${STRAVA}" target="_blank" rel="noopener">Strava Club</a> bei.`,
      },
      {
        q: "Welches Rad brauche ich?",
        html: `Rennrad oder Gravelbike – beides ist willkommen. Hauptsache, dein Rad ist fahrbereit.`,
      },
      {
        q: "Ist ein Helm Pflicht?",
        html: `Ja. Ohne Helm kannst du leider nicht mitfahren – da machen wir keine Ausnahme.`,
      },
      {
        q: "Wie lang sind die Runden?",
        html: `Ein Weekly Ride hat rund 40 km und 350 Höhenmeter, ein Rookie Ride rund 31 km und 240 Höhenmeter. Bei Events geben wir Strecke und Höhenmeter vorher bekannt.`,
      },
      { q: "Was passiert, wenn ich nicht mithalten kann?", html: `` },
      { q: "Darf ich mit E-Bike mitfahren?", html: `` },
      { q: "Fahrt ihr auch bei Regen und im Winter?", html: `` },
    ],
  },
  {
    title: "Events",
    items: [
      {
        q: "Wie melde ich mich für ein Event an?",
        html: `Alle Events findest du unter <a href="/events">Events</a>. Dort meldest du dich direkt an – bei Events mit Teilnahmegebühr bezahlst du gleich online. Danach bekommst du eine Bestätigung per E-Mail.`,
      },
      {
        q: "Ich kann doch nicht – was jetzt?",
        html: `Sag uns bitte so früh wie möglich Bescheid. Die Gebühr erstatten wir grundsätzlich nicht, du kannst deinen Platz aber nach Absprache an jemand anderen weitergeben. Alles Weitere steht in den <a href="/rechtliches#teilnahmebedingungen">Teilnahmebedingungen</a>.`,
      },
      {
        q: "Wo finde ich Fotos und Videos?",
        html: `Bei vergangenen Events unter <a href="/events">Events</a> – über den Button „Fotos & Videos“. Das Passwort steht in deiner Anmeldebestätigung.`,
      },
    ],
  },
  {
    title: "Community",
    items: [
      {
        q: "Wie bleibe ich auf dem Laufenden?",
        html: `Alle Ausfahrten, Absagen und Neuigkeiten gibt es zuerst im <a href="${STRAVA}" target="_blank" rel="noopener">Strava Club</a>. Eindrücke von unterwegs findest du auf <a href="${INSTAGRAM}" target="_blank" rel="noopener">Instagram</a>.`,
      },
      { q: "Muss ich Mitglied im Verein werden?", html: `` },
      { q: "Gibt es ein Gruppetto-Trikot?", html: `` },
      { q: "Wie kann ich mithelfen oder Ride Leader werden?", html: `` },
      {
        q: "Bin ich bei euch versichert?",
        html: `Die Teilnahme an unseren Ausfahrten und Events erfolgt auf eigene Verantwortung. Eine eigene Haftpflichtversicherung empfehlen wir dir deshalb sehr.`,
      },
    ],
  },
];

// Strukturierte Daten für Google (nur beantwortete Fragen)
const strip = (h: string) => h.replace(/<[^>]+>/g, "");
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: groups.flatMap((g) =>
    g.items.filter((i) => i.html).map((i) => ({
      "@type": "Question",
      name: i.q,
      acceptedAnswer: { "@type": "Answer", text: strip(i.html) },
    })),
  ),
};
---

<Layout title="FAQ" description="Häufige Fragen an Gruppetto Tübingen: Treffpunkt, Tempo, Rad, Helm, Events und Community.">
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <section class="faq">
    <p class="faq-tag">FAQ</p>
    <h1>Häufige Fragen.</h1>
    <p class="faq-lead">Alles, was du vor deiner ersten Ausfahrt wissen willst. Deine Frage ist nicht dabei? Frag uns beim nächsten Ride oder <a href="#kontakt">schreib uns</a>.</p>

    {groups.map((g) => (
      <div class="faq-group">
        <h2>{g.title}</h2>
        <div class="faq-list">
          {g.items.map((it) => (
            <details>
              <summary>
                <span>{it.q}</span>
                <span class="faq-plus" aria-hidden="true"></span>
              </summary>
              {it.html ? <p set:html={it.html} /> : <p class="faq-todo">Antwort folgt.</p>}
            </details>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>

<style>
  .faq { padding: 3rem 0 6rem; max-width: 52rem; margin: 0 auto; text-align: center; }
  .faq-tag {
    display: inline-block; margin: 0 0 1.4rem; padding: 0.35rem 0.8rem;
    border: 1px solid var(--blue-500); color: var(--blue-500);
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em;
  }
  .faq h1 { margin: 0 0 1rem; font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; }
  .faq-lead { margin: 0 auto 3.5rem; max-width: 34rem; color: var(--color-text-muted); line-height: 1.6; }
  .faq-lead a { color: var(--color-text); text-underline-offset: 3px; }

  .faq-group { text-align: left; margin-bottom: 3rem; }
  .faq-group h2 {
    margin: 0 0 0.9rem; font-family: var(--font-body); font-size: 0.8rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-muted);
  }
  .faq-list { border: 1px solid var(--color-line); background: var(--light-100); }
  .faq-list details + details { border-top: 1px solid var(--color-line); }

  .faq-list summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1.15rem 1.4rem; font-weight: 600; font-size: 1.05rem; line-height: 1.35;
    transition: color 0.2s ease;
  }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary:hover { color: var(--blue-500); }
  .faq-list summary:focus-visible { outline: 2px solid var(--blue-500); outline-offset: -2px; }

  /* Plus in Akzentblau – dreht sich beim Öffnen zum Kreuz */
  .faq-plus { position: relative; flex: none; width: 16px; height: 16px; transition: transform 0.35s cubic-bezier(0.76, 0, 0.24, 1); }
  .faq-plus::before, .faq-plus::after {
    content: ""; position: absolute; left: 0; top: calc(50% - 1px); width: 100%; height: 2px; background: var(--blue-500);
  }
  .faq-plus::after { transform: rotate(90deg); }
  details[open] .faq-plus { transform: rotate(45deg); }

  .faq-list details p { margin: 0; padding: 0 1.4rem 1.4rem; max-width: 42rem; color: var(--color-text-muted); line-height: 1.65; }
  .faq-list details p :global(a) { color: var(--color-text); text-underline-offset: 3px; }
  .faq-list details p :global(a:hover) { text-decoration-thickness: 2px; }
  .faq-todo { font-style: italic; opacity: 0.7; }

  /* weiches Aufklappen in Browsern, die das schon können */
  @supports (interpolate-size: allow-keywords) {
    .faq-list { interpolate-size: allow-keywords; }
    .faq-list details::details-content {
      height: 0; overflow: clip; transition: height 0.4s cubic-bezier(0.76, 0, 0.24, 1), content-visibility 0.4s allow-discrete;
    }
    .faq-list details[open]::details-content { height: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-plus, .faq-list details::details-content { transition: none; }
  }

  @media (max-width: 760px) {
    .faq { padding-top: 1rem; }
    .faq-list summary { padding: 1rem 1.1rem; font-size: 1rem; }
    .faq-list details p { padding: 0 1.1rem 1.2rem; }
  }
</style>
