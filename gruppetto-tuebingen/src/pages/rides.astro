---
import Layout from "../layouts/Layout.astro";

// Trag hier eure kommenden Rides ein – einfach neue Objekte hinzufügen.
const rides = [
  {
    title: "Mittwoch-Afterworkride",
    when: "Jeden Mittwoch, 18:15 Uhr",
    meet: "Treffpunkt: Finanzamt Tübingen",
    level: "Locker · alle Levels",
    cta: { label: "Zu den Routen", href: "#unsere-routen" },
  },
  {
    title: "Gravel-Treff",
    when: "Donnerstags, 18:30 Uhr",
    meet: "Treffpunkt: Technisches Rathaus",
    level: "Locker",
  },
];

const routes = [
  {
    title: "Route Wildgehege",
    komoot: "https://www.komoot.de/tour/3107579171?ref=aso&share_token=ayTfFgHvYGZdibSgub9XGmMQ8EvotFr8nTJZtIXo7nAPHO5blk&t_s=referral&t_cid=route_share",
    distance: "40,5 km",
    elevation: "320 hm",
    gpx: "2026-08-07_3178072259_Gruppetto - Wildgehege.gpx",
  },
  {
    title: "Route Remmingsheim - Abfahrt Obernau",
    komoot: "https://www.komoot.de/tour/2872772668?ref=aso&share_token=aN1dHrUuscpq2MVgFKhKswQlz03wEG4leQlEhfZCBJy46ctMdd&t_s=referral&t_cid=route_share",
    distance: "42,2 km",
    elevation: "330 hm",
    gpx: "2026-08-07_3178073250_Gruppetto - Remmingsheim - Abfahrt Obernau.gpx",
  },
  {
    title: "Route Anstieg Gomaringen",
    komoot: "https://www.komoot.de/tour/2872010328?ref=aso&share_token=aBtwKAVuSfEaoloLvlk81wIlTYgJjC3GZpNni7NyQ59HKCBaO0&t_s=referral&t_cid=route_share",
    distance: "44,1 km",
    elevation: "430 hm",
    gpx: "2026-08-07_3178073931_Gruppetto - Anstieg Gomaringen.gpx",
  },
  {
    title: "Route Kressbach - Dettinger Täle",
    komoot: "https://www.komoot.de/tour/2872010477?ref=aso&share_token=aw8bAQE3GblVSgYUOJT7GCX7wuU5wuDj4KFXrT7XOCGS6oyLLi&t_s=referral&t_cid=route_share",
    distance: "39,5 km",
    elevation: "320 hm",
    gpx: "2026-08-07_3178074443_Gruppetto - Kressbach - Dettinger Täle.gpx",
  },
  {
    title: "Route Hornbach Climb - Ofterdingen",
    komoot: "https://www.komoot.de/tour/2872010689?ref=aso&share_token=aVZ58OnvVY3l8x75EeTBxinXafU48ZBwXNZchfzp0ksKfrAqED&t_s=referral&t_cid=route_share",
    distance: "39,4 km",
    elevation: "280 hm",
    gpx: "2026-07-29_3152890761_Gruppetto - Hornbach Climb - Ofterdingen.gpx",
  },
  {
    title: "Route Hügellover",
    komoot: "https://www.komoot.de/tour/3110401484?ref=aso&share_token=aNgXXSah6G1MNCuUdCt9KpsW2ebPFfD4aU6KSmVOLINRJh49W4&t_s=referral&t_cid=route_share",
    distance: "41,6 km",
    elevation: "510 hm",
    hidden: true
  },
];
---

<Layout title="Rides" description="Kommende Ausfahrten von Gruppetto Tübingen">
  <section style="padding: 3rem 0;">
    <h1>Rides</h1>
    <p style="color: var(--color-text-muted); margin-bottom: 2rem;">
      Jede Woche zwischen April und Oktober
    </p>

    {
      rides.map((ride) => (
        <div class="card">
          <h3 style="margin: 0 0 0.5rem;">{ride.title}</h3>
          <p style="margin: 0; color: var(--color-text-muted);">{ride.when}</p>
          <p style="margin: 0; color: var(--color-text-muted);">{ride.meet}</p>
          <p style="margin: 0.5rem 0 0; color: var(--color-accent); font-weight: 600;">
            {ride.level}
          </p>
        {ride.cta && (
          <a href={ride.cta.href} class="btn" style="margin-top: 1rem;">
            {ride.cta.label}
          </a>
        )}
        </div>
      ))
    }
  </section>

<section style="padding: 3rem 0;">
  <h1>Unser Konzept</h1>
  <p style="color: var(--color-text-muted); margin-bottom: 2rem;">
    Seit der Saison 2026 bieten wir keinen aktiven Lead mehr an. Bedeutet für euch: Ihr seid selber verantwortlich, die Route parat zu haben. Keine Sorge: 
    Falls ihr keinen Radcomputer oder ähnliches besitzt, hat sicher jemand anderes aus der Gruppe die Route parat!
  </p>
</section>

<section id="unsere-routen" style="padding: 3rem 0;">
    <h1>Unsere Routen</h1>
    <p style="color: var(--color-text-muted); margin-bottom: 2rem;">
      Unsere liebsten Strecken rund um Tübingen. Falls ihr bei unseren Afterwork Rides teilnehmen wollt, ist es sinnvol die Strecken vorab herunterzuladen. Es gibt keinen offiziellen Lead mehr!
    </p>

    {
                routes.map((route, i) => (
        <div class="card" style="display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem;">
            <div style="flex: 1 1 240px;">
              <h3 style="margin: 0 0 0.75rem;">{route.title}</h3>
              <p style="margin: 0; color: var(--color-text-muted);">
                {route.distance} · {route.elevation}
              </p>
              <a href={route.komoot} target="_blank" rel="noopener" class="btn" style="margin-top: 1rem;">
                Zur Route auf Komoot
              </a>
            </div>
{route.gpx ? (
              <div id={`gpx-map-${i}`} data-gpx={route.gpx} style="flex: 1 1 280px; height: 180px; border-radius: 12px; overflow: hidden;"></div>
            ) : (
              <div style="flex: 1 1 280px; background: var(--color-bg); border: 1px dashed var(--color-text-muted); border-radius: 12px; height: 180px; display: flex; align-items: center; justify-content: center; color: var(--color-text-muted);">
                Streckenbild folgt
              </div>
            )}
          </div>
      ))
    }
  </section>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script is:inline src="https://unpkg.com/leaflet-gpx@2.1.2/gpx.js"></script>
    <script is:inline>
      window.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll("[data-gpx]").forEach(function (el) {
          var gpxUrl = encodeURI("/" + el.dataset.gpx);
          var map = L.map(el, { scrollWheelZoom: false });
          L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png", {
            attribution: "&copy; OpenStreetMap contributors &copy; CARTO",
            maxZoom: 19,
          }).addTo(map);
          map.createPane("labelsPane");
          map.getPane("labelsPane").style.zIndex = 650;
          map.getPane("labelsPane").style.pointerEvents = "none";
          L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_only_labels/{z}/{x}/{y}{r}.png", {
            pane: "labelsPane",
            maxZoom: 19,
          }).addTo(map);
          new L.GPX(gpxUrl, {
            async: true,
            polyline_options: { color: "#d7f542", weight: 4 },
          })
            .on("loaded", function (e) {
              map.fitBounds(e.target.getBounds());
              function stripMarkers(layer) {
                if (layer instanceof L.Marker) {
                  layer.remove();
                } else if (layer.eachLayer) {
                  layer.eachLayer(stripMarkers);
                }
              }
              e.target.eachLayer(stripMarkers);
            })
            .addTo(map);
        });
      });
    </script>
</Layout>
