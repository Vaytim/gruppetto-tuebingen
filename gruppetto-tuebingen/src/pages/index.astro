---
// Startseite. Aufbau von oben nach unten:
//  1. Vollbild-Hero (Bild, große Headline links oben, großes Datum rechts unten)
//  2. Intro-Text in der rechten Hälfte
//  3. 2×2-Bildkacheln mit "Titel ⟶" und Kurztext
//  4. Vollbreites Banner mit Headline + Button
//  5. Slider "Events" mit Pfeil-Buttons (kommende + letzte vergangene)
//  6. Farbiges Band mit 4 Karten + Button
// Alle Texte/Bilder unten in den Konstanten anpassen.
import Layout from "../layouts/Layout.astro";
import { codeEventsPublic, nextRookieRide, shortDate, slideHTML, splitEvents } from "../lib/public-events";
import "../styles/event-slider.css";

const hero = {
  // Hintergrundvideo: stumm, Dauerschleife. Poster = Standbild, bis das Video lädt.
  video: "/images/hero.mp4",
  videoWebm: "/images/hero.webm", // Ersatz für Browser ohne MP4/H.264
  poster: "/images/hero-poster.jpg",
  headline: ["Keep it simple.", "Ride together."],
};

const intro =
  "Gruppetto Tübingen ist eine lokale Rennrad-Community rund um Tübingen – gemeinsame Ausfahrten, eine offene Community für Neueinsteiger:innen und unterschiedlichste Events. Jeder wird hier fündig.";

const tiles = [
  { title: "Weekly Rides", href: "/rides", text: "Regelmäßige Rides für alle Levels – vom entspannten Grundlagentraining bis zur zügigen Ausfahrt.", image: "/images/weekly-rides.jpg" },
  { title: "Events", href: "/events", text: "Ausfahrten, Workshops und unser Saisonabschluss – alle Termine auf einen Blick.", image: "/images/events-everesting.jpg" },
  { title: "Über uns", href: "/ueber-uns", text: "Wer wir sind, wie wir fahren und wie du Anschluss findest.", image: "/images/ueber-uns.jpg" },
  { title: "Shop", href: "/shop", text: "Season 2026 Kit, Sticker und mehr aus der Gruppetto-Ausrüstung.", image: "/images/shop-collage.jpg" },
];

const banner = {
  image: "https://picsum.photos/seed/gruppetto-rookies/1800/900",
  headline: ["Gruppetto", "Rookies"],
  cta: { label: "Mehr erfahren", href: "/rookies" },
};

// Trikot & Bib werden bei Spatzwear verkauft
const SPATZWEAR = "https://www.spatzwear-custom.com/collections/gruppetto-tu";

const shopBand = {
  title: "Gruppetto-Shop",
  items: [
    { title: "Season 2026 Kit – Trikot", note: "Bei Spatzwear erhältlich", image: "/images/kit/trikot-vorne.jpg", href: SPATZWEAR },
    { title: "Season 2026 Kit – Bib", note: "Bei Spatzwear erhältlich", image: "/images/kit/bib.jpg", href: SPATZWEAR },
    { title: "Gruppetto Sticker Set", note: "Bald verfügbar", image: "" /* noch kein Foto – weiße Fläche */, href: "/shop" },
    { title: "Trinkflasche", note: "Bald verfügbar", image: "" /* noch kein Foto – weiße Fläche */, href: "/shop" },
  ],
  cta: { label: "Zum Shop", href: "/shop" },
};

// Events: vorab aus src/data/events.ts gerendert, im Browser durch /api/events
// ersetzt (dann auch mit den Events aus der Verwaltung).
const { upcoming, past } = splitEvents(codeEventsPublic(), 4); // die letzten 4 vergangenen
const rookie = nextRookieRide(codeEventsPublic());
const next = upcoming[0];
// Vergangene Events links vom nächsten Event (älteste ganz links), kommende rechts
const slidesFor = (u: typeof upcoming, p: typeof past) =>
  [...p.slice().reverse().map((e) => slideHTML(e, { past: true })), ...u.map((e) => slideHTML(e))].join("");
const slides = slidesFor(upcoming, past);
---

<Layout title="Startseite" fullBleed>
  <!-- 1. Hero -->
  <section class="hero">
    <video class="hero-img" poster={hero.poster} autoplay muted loop playsinline preload="auto" aria-hidden="true">
      <source src={hero.video} type="video/mp4" />
      <source src={hero.videoWebm} type="video/webm" />
    </video>
    <h1 class="hero-headline">{hero.headline.map((line) => <span>{line}</span>)}</h1>
    <a class="hero-date" href="/events" hidden={!next}>
      <span class="hero-date-label">Nächstes Event: <span data-next-title>{next?.title}</span></span>
      <span class="hero-date-value" data-next-date>{next ? shortDate(next.dateISO) : ""}</span>
    </a>
  </section>

  <!-- 2. Intro -->
  <section class="intro">
    <p>{intro}</p>
  </section>

  <!-- 3. Kacheln -->
  <section class="tiles">
    {tiles.map((t) => (
      <a class="tile" href={t.href}>
        <div class="tile-media"><img src={t.image} alt="" loading="lazy" /></div>
        <div class="tile-body">
          <h2 class="arrow-title">{t.title}</h2>
          <p>{t.text}</p>
        </div>
      </a>
    ))}
  </section>

  <!-- 4. Banner -->
  <section class="banner">
    <img src={banner.image} alt="" loading="lazy" />
    <h2 class="banner-headline">{banner.headline.map((l) => <span>{l}</span>)}</h2>
    <a class="btn banner-cta" href={banner.cta.href}>{banner.cta.label}</a>
    <!-- gleicher Stil wie "Nächstes Event" im Hero -->
    <a class="hero-date banner-date" href="/rookies#naechster-rookie-ride" data-rookie-next hidden={!rookie}>
      <span class="hero-date-label">Nächster Rookie Ride<span data-rookie-time>{rookie?.time ? ` · ${rookie.time}` : ""}</span></span>
      <span class="hero-date-value" data-rookie-date>{rookie ? shortDate(rookie.dateISO) : ""}</span>
      <span class="rookie-status" data-rookie-status hidden></span>
    </a>
  </section>

  <!-- 5. Slider Events -->
  <section class="slider" aria-labelledby="slider-title">
    <div class="slider-head">
      <h2 id="slider-title">Events</h2>
      <div class="slider-nav">
        <button type="button" data-dir="-1" aria-label="Zurück">←</button>
        <button type="button" data-dir="1" aria-label="Weiter">→</button>
      </div>
    </div>
    <div class="slider-track" tabindex="0" set:html={slides} />
  </section>

  <!-- 6. Farbiges Band -->
  <section class="band">
    <h2 class="band-title">{shopBand.title}</h2>
    <div class="band-grid">
      {shopBand.items.map((item) => (
        <a class="band-card" href={item.href} {...(item.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>
          {item.image ? <img src={item.image} alt="" loading="lazy" /> : <div class="band-blank" aria-hidden="true" />}
          <h3>{item.title}</h3>
          <p>{item.note}</p>
        </a>
      ))}
    </div>
    <div class="band-cta"><a class="btn" href={shopBand.cta.href}>{shopBand.cta.label}</a></div>
  </section>
</Layout>

<script>
  import { ensureAutoplay, initReelHover } from "../lib/motion";
  import { fetchEvents, keepAlignedOnResize, codeEventsPublic, fetchRookieFull, nextRookieRide, scrollToFirstUpcoming, shortDate, showRookieStatus, slideHTML, splitEvents, wireSlider } from "../lib/public-events";

  // Nächster Rookie Ride im Banner (inkl. Events aus der Verwaltung) + Status
  Promise.all([fetchEvents(), fetchRookieFull()]).then(([all, full]) => {
    const box = document.querySelector<HTMLElement>("[data-rookie-next]");
    const r = nextRookieRide(all ?? codeEventsPublic());
    if (!box) return;
    box.hidden = !r;
    if (r) {
      box.querySelector("[data-rookie-date]")!.textContent = shortDate(r.dateISO);
      box.querySelector("[data-rookie-time]")!.textContent = r.time ? ` · ${r.time}` : "";
    }
    showRookieStatus(box.querySelector("[data-rookie-status]"), !!r, full);
  });

  // Events inkl. der in der Verwaltung angelegten nachladen
  fetchEvents().then((all) => {
    if (!all) return;
    const { upcoming, past } = splitEvents(all, 4);
    const track = document.querySelector<HTMLElement>(".slider-track");
    if (track) {
      track.innerHTML = [...past.slice().reverse().map((e) => slideHTML(e, { past: true })), ...upcoming.map((e) => slideHTML(e))].join("");
      scrollToFirstUpcoming(track);
    }
    const next = upcoming[0];
    const hero = document.querySelector<HTMLAnchorElement>(".hero-date");
    if (hero) {
      hero.hidden = !next;
      if (next) {
        hero.querySelector("[data-next-title]")!.textContent = next.title;
        hero.querySelector("[data-next-date]")!.textContent = shortDate(next.dateISO);
      }
    }
  });

  // Hero-Video zuverlässig starten (wer "Bewegung reduzieren" eingestellt hat, sieht nur das Standbild)
  const heroVideo = document.querySelector<HTMLVideoElement>(".hero video");
  if (heroVideo) ensureAutoplay(heroVideo);

  document.querySelectorAll<HTMLElement>(".slider").forEach((slider) => {
    wireSlider(slider);
    const track = slider.querySelector<HTMLElement>(".slider-track")!;
    scrollToFirstUpcoming(track); // vorab gerenderte Liste
    keepAlignedOnResize(track);
    initReelHover(track);
  });
</script>

<style>
  /* 1. Hero */
  .hero { position: relative; min-height: calc(100svh - var(--info-bar-h)); overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(2,24,89,.55), rgba(2,24,89,.1) 45%, rgba(13,30,64,.7)); }
  .hero-headline {
    position: relative; z-index: 1; display: grid; margin: 0; padding: 18vh var(--gutter) 0;
    font-size: clamp(3.2rem, 8.4vw, 9rem); line-height: 0.98; color: var(--color-highlight);
  }
  .hero-date {
    position: absolute; z-index: 1; right: var(--gutter); bottom: 6vh; display: grid; justify-items: end; text-decoration: none;
  }
  .hero-date[hidden] { display: none; }
  .hero-date-label { font-size: 1rem; margin-bottom: 0.5rem; }
  .hero-date-value { font-family: var(--font-title); font-size: clamp(3.5rem, 9vw, 9.5rem); line-height: 0.9; color: var(--color-highlight); }

  /* 2. Intro */
  /* helle Abschnitte: Intro + Kacheln */
  .intro, .tiles { background: var(--light-100); color: var(--navy-800); }
  .intro { display: grid; grid-template-columns: 1fr 1fr; padding: 7rem var(--gutter); }
  .intro p { grid-column: 2; margin: 0; max-width: 40rem; font-size: clamp(1.4rem, 2.3vw, 2.2rem); line-height: 1.25; }

  /* 3. Kacheln */
  /* Kacheln: Titel + Text in einer transparenten Box IM Bild; beim Hovern verschwindet die Box und das Bild zoomt */
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 10px; }
  .tile { position: relative; display: block; overflow: hidden; text-decoration: none; color: var(--light-100); }
  .tile-media { overflow: hidden; }
  .tile img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .tile:hover img, .tile:focus-visible img { transform: scale(1.06); }
  .tile-body {
    position: absolute; left: var(--gutter); right: var(--gutter); bottom: var(--gutter); max-width: 34rem;
    padding: 1.3rem 1.5rem 1.4rem;
    background: rgba(2, 24, 89, 0.45); /* stark transparent, Text bleibt auch auf hellen Bildern lesbar */
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tile h2 { margin: 0 0 0.6rem; font-size: clamp(1.6rem, 2.4vw, 2.4rem); }
  .tile p { margin: 0; font-size: 1.05rem; line-height: 1.45; color: rgba(242, 242, 242, 0.9); }
  /* Nur auf Geräten mit Maus: Box ausblenden, Bild freigeben (Touch: Box bleibt sichtbar) */
  @media (hover: hover) {
    .tile:hover .tile-body, .tile:focus-visible .tile-body { opacity: 0; transform: translateY(12px); }
  }
  @media (prefers-reduced-motion: reduce) { .tile img, .tile-body { transition: none; } }

  /* 4. Banner */
  .banner { position: relative; min-height: 70vh; margin-top: 3rem; overflow: hidden; }
  .banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .banner::after { content: ""; position: absolute; inset: 0; background: rgba(2,24,89,.35); }
  .banner-headline {
    position: absolute; z-index: 1; top: var(--gutter); right: var(--gutter); margin: 0; display: grid; justify-items: end;
    font-size: clamp(2.8rem, 6vw, 6.5rem); line-height: 1;
  }
  .banner-cta { position: absolute; z-index: 1; left: var(--gutter); bottom: var(--gutter); }
  /* Rookie-Termin: Stil von .hero-date (Hero), hier im Banner */
  .banner-date { bottom: var(--gutter); }
  .banner-date .rookie-status { margin-top: 0.9rem; }
  @media (max-width: 760px) { .banner-date { bottom: calc(var(--gutter) + 4.2rem); } }

  /* 6. Farbiges Band */
  .band { background: var(--color-accent); color: var(--color-on-accent); padding: 1.5rem var(--gutter) 3rem; }
  .band-title { margin: 0 0 4rem; padding-left: 0.5rem; font-size: clamp(2.6rem, 4.6vw, 4.6rem); }
  .band-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .band-card { display: block; background: var(--light-100); color: var(--navy-800); padding: 1.2rem 1.2rem 1.6rem; text-decoration: none; }
  .band-card img, .band-blank { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; margin-bottom: 1.2rem; }
  .band-blank { background: #fff; }
  .band-card h3 { margin: 0 0 0.9rem; font-family: var(--font-body); font-weight: 500; font-size: 1.25rem; line-height: 1.3; text-decoration: underline; text-underline-offset: 5px; }
  .band-card p { margin: 0; text-align: center; font-size: 0.9rem; color: var(--navy-700); }
  .band-card:hover h3 { text-decoration-thickness: 2px; }
  .band-cta { display: flex; justify-content: center; margin-top: 3.5rem; }

  /* Mobil */
  @media (max-width: 760px) {
    .hero-headline { padding-top: 22vh; }
    .hero-date { left: var(--gutter); }
    .hero-date-label { text-align: right; }
    .intro { grid-template-columns: 1fr; padding: 4rem var(--gutter); }
    .intro p { grid-column: 1; }
    .tiles { grid-template-columns: 1fr; }
    .tiles { gap: 8px; padding: 8px; }
    .tile-body { padding: 1rem 1.1rem; }
    .tile p { font-size: 0.95rem; }
    .band-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
