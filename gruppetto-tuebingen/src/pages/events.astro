---
import Layout from "../layouts/Layout.astro";
import { codeEventsPublic, slideHTML, splitEvents } from "../lib/public-events";
import "../styles/event-slider.css";

// Vorab gerendert (Fallback ohne JavaScript/Backend). Im Browser wird die Liste
// mit /api/events ersetzt – dort sind auch die Events aus der Verwaltung dabei.
const { upcoming, past } = splitEvents(codeEventsPublic());
---

<Layout title="Events" fullBleed>
  <!-- Kommende Events: gleiche Slider-Blöcke wie auf der Startseite -->
  <section class="slider events-slider" aria-labelledby="events-title">
    <div class="slider-head">
      <h1 id="events-title">Events</h1>
      <div class="slider-nav">
        <button type="button" data-dir="-1" aria-label="Zurück">←</button>
        <button type="button" data-dir="1" aria-label="Weiter">→</button>
      </div>
    </div>
    <p class="events-intro">Wir haben euer Feedback der letzten Saison ausgewertet. Der klare Wunsch: mehr gemeinsame Events! Wer wären wir, wenn wir dem nicht nachkommen? Hier findet ihr unseren aktuellen Eventkalender und alle von uns organisierten Rides.</p>
    <p class="notice" id="cancel-notice" hidden>
      Bezahlung abgebrochen – du bist nicht angemeldet. Dein reservierter Platz wird in Kürze wieder freigegeben.
    </p>
    <div class="slider-track" tabindex="0" id="events-upcoming" set:html={upcoming.map((e) => slideHTML(e, { mode: "detail" })).join("")} />
    <p class="no-events" id="events-none" hidden={upcoming.length > 0}>Aktuell sind keine Events geplant - schaut bald wieder vorbei!</p>
  </section>

  <!-- Vergangene Events: separat darunter, kleiner -->
  <section class="past-section" id="past-section" hidden={past.length === 0} aria-labelledby="past-title">
    <h2 class="past-title" id="past-title">Vergangene Events</h2>
    <div class="past-grid" id="events-past" set:html={past.map((e) => slideHTML(e, { past: true, mode: "detail" })).join("")} />
  </section>

  <dialog id="register-dialog" aria-labelledby="register-title">
    <form id="register-form" novalidate>
      <button type="button" class="dialog-close" aria-label="Schließen" data-close>×</button>
      <p class="event-date" id="register-date"></p>
      <h2 id="register-title">Anmeldung</h2>

      <label>
        Vor- und Nachname
        <input name="name" autocomplete="name" required minlength="2" maxlength="100" />
      </label>
      <label>
        E-Mail (für Startnummer &amp; Bestätigung)
        <input name="email" type="email" autocomplete="email" required maxlength="200" />
      </label>
      <label class="checkbox">
        <input name="acceptTerms" type="checkbox" required />
        <span>
          Ich habe die <a href="/rechtliches" target="_blank">Teilnahmebedingungen und die Datenschutzhinweise</a> gelesen und nehme auf eigene Verantwortung teil.
        </span>
      </label>

      <p class="form-error" role="alert" hidden></p>

      <button type="submit" class="btn-pay">Weiter zur Bezahlung · <span id="register-price"></span></button>
      <p class="form-hint">Sichere Bezahlung über Stripe (Karte, Apple Pay, Google Pay). Dein Platz ist 30 Minuten für dich reserviert.</p>
    </form>
  </dialog>
</Layout>

<script>
  import { fetchEvents, slideHTML, splitEvents, wireSlider } from "../lib/public-events";

  const dialog = document.getElementById("register-dialog") as HTMLDialogElement;
  const form = document.getElementById("register-form") as HTMLFormElement;
  const errorBox = form.querySelector(".form-error") as HTMLElement;
  const payButton = form.querySelector(".btn-pay") as HTMLButtonElement;
  let currentEventId = "";

  type Status = Record<string, { capacity: number; taken: number; remaining: number; open: boolean }>;

  function setSeats(eventId: string, text: string, soldOut = false) {
    const el = document.querySelector<HTMLElement>(`[data-seats-for="${eventId}"]`);
    if (el) {
      el.textContent = text;
      el.classList.toggle("sold-out", soldOut);
    }
  }

  async function loadStatus() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".btn-register");
    let status: Status = {};
    try {
      const res = await fetch("/api/event-status", { cache: "no-store" });
      if (res.ok) status = await res.json();
    } catch {
      /* offline oder lokale Vorschau ohne Backend */
    }
    buttons.forEach((btn) => {
      const id = btn.dataset.eventId!;
      const s = status[id];
      const closed = Date.now() >= new Date(btn.dataset.closesAt!).getTime();
      if (closed) {
        btn.disabled = true;
        btn.textContent = "Anmeldung geschlossen";
        setSeats(id, "");
      } else if (!s) {
        btn.disabled = true;
        setSeats(id, "Anmeldung gerade nicht verfügbar");
      } else if (s.remaining <= 0) {
        btn.disabled = true;
        btn.textContent = "Ausgebucht";
        setSeats(id, `Alle ${s.capacity} Plätze vergeben`, true);
      } else {
        btn.disabled = false;
        setSeats(id, `Noch ${s.remaining} von ${s.capacity} Plätzen frei`);
      }
    });
  }

  // Event-Delegation: funktioniert auch, nachdem die Liste neu gerendert wurde
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".btn-register");
    if (!btn || btn.disabled) return;
    currentEventId = btn.dataset.eventId!;
    document.getElementById("register-title")!.textContent = btn.dataset.eventTitle!;
    document.getElementById("register-date")!.textContent = btn.dataset.eventDate!;
    document.getElementById("register-price")!.textContent = btn.dataset.eventPrice!;
    errorBox.hidden = true;
    dialog.showModal();
    (form.elements.namedItem("name") as HTMLInputElement).focus();
  });

  dialog.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close(); // Klick auf den Hintergrund
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox.hidden = true;
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    payButton.disabled = true;
    const label = payButton.innerHTML;
    payButton.textContent = "Einen Moment …";
    try {
      const res = await fetch("/api/checkout", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          eventId: currentEventId,
          name: data.get("name"),
          email: data.get("email"),
          acceptTerms: data.get("acceptTerms") === "on",
        }),
      });
      const body = await res.json().catch(() => ({}));
      if (res.ok && body.url) {
        window.location.href = body.url; // → Stripe Checkout
        return;
      }
      errorBox.textContent = body.error ?? "Etwas ist schiefgelaufen. Bitte versuch es erneut.";
      errorBox.hidden = false;
      if (body.soldOut) loadStatus();
    } catch {
      errorBox.textContent = "Keine Verbindung. Bitte prüf dein Internet und versuch es erneut.";
      errorBox.hidden = false;
    }
    payButton.disabled = false;
    payButton.innerHTML = label;
  });

  if (new URLSearchParams(location.search).has("abgebrochen")) {
    document.getElementById("cancel-notice")!.hidden = false;
  }

  async function init() {
    const all = await fetchEvents();
    if (all) {
      const { upcoming, past } = splitEvents(all);
      document.getElementById("events-upcoming")!.innerHTML = upcoming.map((ev) => slideHTML(ev, { mode: "detail" })).join("");
      document.getElementById("events-none")!.hidden = upcoming.length > 0;
      document.getElementById("events-past")!.innerHTML = past.map((ev) => slideHTML(ev, { past: true, mode: "detail" })).join("");
      document.getElementById("past-section")!.hidden = past.length === 0;
    }
    loadStatus();
    focusHashTarget();
  }

  // Von der Startseite kommend (/events#event-…): Event ins Bild holen und kurz hervorheben
  function focusHashTarget() {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = id ? document.getElementById(id) : null;
    if (!el) return;
    const track = el.closest<HTMLElement>(".slider-track");
    if (track) {
      const pad = parseFloat(getComputedStyle(track).paddingLeft) || 0;
      track.scrollTo({ left: el.offsetLeft - pad });
    }
    el.scrollIntoView({ block: "center" });
    el.classList.add("is-target");
    setTimeout(() => el.classList.remove("is-target"), 2200);
  }

  wireSlider(document.querySelector<HTMLElement>(".events-slider")!);
  init();
</script>

<style is:global>
  .events-slider { padding-top: calc(var(--gutter) * 2 + 8rem); padding-bottom: 5rem; }
  .events-intro { max-width: 42rem; margin: 0 0 2.5rem; padding: 0 var(--gutter); color: var(--color-text-muted); font-size: 1.1rem; }
  .no-events { padding: 0 var(--gutter); color: var(--color-text-muted); }
  .events-slider .notice { margin: 0 var(--gutter) 1.5rem; }

  .slide-actions { margin-top: auto; padding-top: 1.25rem; }
  .slide.is-target .slide-media { outline: 3px solid var(--color-highlight); outline-offset: 4px; }

  .btn-strava {
    display: block; margin-top: 0.6rem; text-align: center; border-radius: 999px; padding: 0.7rem 1.2rem;
    border: 1px solid var(--color-text); color: var(--color-text); text-decoration: none; font-weight: 700; font-size: 0.95rem;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .btn-strava:hover { background: var(--color-text); color: var(--navy-800, #021859); }
  .btn-strava:focus-visible { outline: 2px solid var(--color-text); outline-offset: 3px; }

  /* Vergangene Events – kleiner, 4 nebeneinander */
  .past-section { padding: 1rem var(--gutter) 6rem; border-top: 1px solid var(--color-line); }
  .past-title { margin: 2.5rem 0 1.6rem; font-size: clamp(1.8rem, 3.2vw, 2.8rem); line-height: 1.1; }
  .past-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .past-grid .slide-media { aspect-ratio: 4 / 3; margin-bottom: 0.9rem; }
  .past-grid .slide h3 { font-size: 1.05rem; margin-bottom: 0.4rem; }
  .past-grid .slide-meta { font-size: 0.85rem; margin-bottom: 0.5rem; }
  .past-grid .slide p { font-size: 0.9rem; }
  .past-grid .slide .slide-desc { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .past-grid .btn-strava { padding: 0.5rem 0.9rem; font-size: 0.85rem; }
  @media (max-width: 900px) { .past-grid { grid-template-columns: repeat(2, 1fr); } }

  /* Anmeldung */
  .event-card-actions { position: relative; z-index: 2; margin-top: 1.25rem; }
  .btn-register, .btn-pay {
    width: 100%; border: 0; border-radius: 999px; padding: 0.8rem 1.2rem;
    background: var(--color-accent); color: var(--color-on-accent); font: 700 1rem var(--font-body); cursor: pointer;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  .btn-register:hover:not(:disabled), .btn-pay:hover:not(:disabled) { filter: brightness(1.1); }
  .btn-register:disabled, .btn-pay:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-register:focus-visible, .btn-pay:focus-visible { outline: 2px solid var(--color-text); outline-offset: 3px; }
  .seats { margin: 0.5rem 0 0; font-size: 0.85rem; color: var(--color-text-muted); text-align: center; min-height: 1.2em; }
  .seats.sold-out { color: #ff8a7a; }

  .notice { padding: 0.9rem 1.1rem; border-radius: 12px; background: var(--color-bg-alt); border-left: 4px solid var(--color-accent); }

  dialog {
    width: min(460px, calc(100vw - 2rem)); padding: 0; border: 0; border-radius: 20px;
    background: var(--color-bg-alt); color: var(--color-text); box-shadow: 0 30px 80px rgba(2, 24, 89, 0.7);
  }
  dialog::backdrop { background: rgba(13, 30, 64, 0.75); backdrop-filter: blur(3px); }
  #register-form { position: relative; display: grid; gap: 1rem; padding: 2rem 1.5rem 1.5rem; }
  #register-form h2 { margin: 0 0 0.25rem; font-family: var(--font-title); }
  #register-form .event-date { margin: 0; }
  .dialog-close {
    position: absolute; top: 0.75rem; right: 0.75rem; width: 2.25rem; height: 2.25rem; border: 0; border-radius: 50%;
    background: transparent; color: var(--color-text-muted); font-size: 1.6rem; line-height: 1; cursor: pointer;
  }
  .dialog-close:hover { background: var(--color-bg-raised); color: var(--color-text); }
  #register-form label { display: grid; gap: 0.4rem; font-size: 0.9rem; color: var(--color-text-muted); }
  #register-form input:not([type="checkbox"]) {
    padding: 0.75rem 0.9rem; border-radius: 10px; border: 1px solid var(--color-line); background: var(--color-bg);
    color: var(--color-text); font: 1rem var(--font-body);
  }
  #register-form input:focus { outline: 2px solid var(--color-highlight); outline-offset: 1px; }
  #register-form label.checkbox { grid-template-columns: auto 1fr; align-items: start; gap: 0.6rem; }
  #register-form label.checkbox input { margin-top: 0.2rem; accent-color: var(--color-accent); width: 1.1rem; height: 1.1rem; }
  #register-form a { color: var(--color-highlight); }
  .form-error { margin: 0; padding: 0.7rem 0.9rem; border-radius: 10px; background: rgba(255, 110, 90, 0.12); color: #ffb3a7; font-size: 0.9rem; }
  .form-hint { margin: 0; font-size: 0.8rem; color: var(--color-text-muted); text-align: center; }
</style>
